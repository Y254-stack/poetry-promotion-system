        2
    ) AS hotScore,
    DATE_FORMAT(w.created_at, '%Y-%m-%d %H:%i:%s') AS publishTime
FROM poetry_work w
JOIN work_tag wt ON wt.work_id = w.work_id
JOIN tag t ON t.tag_id = wt.tag_id
LEFT JOIN (
    SELECT work_id, COUNT(*) AS relation_count
    FROM work_relation
    GROUP BY work_id
) rel ON rel.work_id = w.work_id
LEFT JOIN (
    SELECT work_id, COUNT(*) AS tag_count
    FROM work_tag
    GROUP BY work_id
) meta ON meta.work_id = w.work_id
WHERE wt.tag_id IN (?)
GROUP BY
    w.work_id,
    w.title,
    w.author_name_cache,
    w.dynasty_name,
    w.content_text,
    w.translation_text,
    w.annotation_text,
    w.appreciation_text,
    w.char_count,
    w.created_at,
    rel.relation_count,
    meta.tag_count
HAVING COUNT(DISTINCT wt.tag_id) = ?
ORDER BY hotScore DESC, w.work_id DESC
LIMIT ? OFFSET ?
]
