<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F0F0F0" />
            <stroke android:width="1dp" android:color="#E0E0E0" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <stroke android:width="1dp" android:color="#D4C4A8" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <!-- Decorative corners or inner border could go here -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="0.5dp" android:color="#E8E0D0" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
