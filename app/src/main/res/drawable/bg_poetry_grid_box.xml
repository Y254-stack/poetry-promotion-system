<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FDF8F0" />
                    <stroke android:width="1.5dp" android:color="#B8860B" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <stroke android:width="1dp" android:color="#D4C4A8" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <!-- Horizontal line -->
            <item android:top="20dp" android:bottom="20dp">
                <shape android:shape="line">
                    <stroke android:width="0.5dp" android:color="#E8E0D0" android:dashWidth="2dp" android:dashGap="2dp" />
                </shape>
            </item>
            <!-- Vertical line -->
            <item android:left="20dp" android:right="20dp">
                <rotate android:fromDegrees="90">
                    <shape android:shape="line">
                        <stroke android:width="0.5dp" android:color="#E8E0D0" android:dashWidth="2dp" android:dashGap="2dp" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>
</selector>
