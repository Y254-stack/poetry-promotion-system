<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFF5F5" />
                    <stroke android:width="2dp" android:color="#E8A0A0" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:top="25dp" android:bottom="25dp">
                <shape android:shape="line">
                    <stroke android:width="1dp" android:color="#E8A0A0" android:dashWidth="4dp" android:dashGap="4dp" />
                </shape>
            </item>
            <item android:left="25dp" android:right="25dp">
                <rotate android:fromDegrees="90">
                    <shape android:shape="line">
                        <stroke android:width="1dp" android:color="#E8A0A0" android:dashWidth="4dp" android:dashGap="4dp" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <stroke android:width="2dp" android:color="#E8A0A0" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:top="25dp" android:bottom="25dp">
                <shape android:shape="line">
                    <stroke android:width="1dp" android:color="#E8A0A0" android:dashWidth="4dp" android:dashGap="4dp" />
                </shape>
            </item>
            <item android:left="25dp" android:right="25dp">
                <rotate android:fromDegrees="90">
                    <shape android:shape="line">
                        <stroke android:width="1dp" android:color="#E8A0A0" android:dashWidth="4dp" android:dashGap="4dp" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>
</selector>
